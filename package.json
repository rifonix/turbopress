{
  "name": "turbopress-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Turbopress (SpeedForge Engine) - High-Performance Zero-DNS WordPress Optimization SaaS & Client",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "dev:edge": "npm run --workspace=@turbopress/edge-api dev",
    "dev:saas": "npm run --workspace=@turbopress/saas-app dev",
    "dev:wp-admin": "npm run --workspace=@turbopress/wp-plugin dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
