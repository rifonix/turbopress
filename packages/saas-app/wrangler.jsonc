{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turbopress-saas-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "turbopress-saas-app"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_dHVyYm9wcmVzcy1kZW1vLWNsaWVudA",
    "NEXT_PUBLIC_API_BASE_URL": "https://turbopress.webaccessibility.workers.dev",
    "ENVIRONMENT": "production"
  }
}