{
  "$schema": "node_modules/wrangler/config-schema.json",
  // WP Instant SaaS Dashboard (OpenNext). Custom domain: wpinstant.dev
  "name": "wpinstant-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    { "pattern": "wpinstant.dev", "custom_domain": true }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "wpinstant-app"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsud3BpbnN0YW50LmRldiQ",
    "NEXT_PUBLIC_API_BASE_URL": "https://api.wpinstant.dev",
    "ENVIRONMENT": "production"
  }
}
