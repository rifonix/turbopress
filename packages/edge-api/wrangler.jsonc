{
  "$schema": "node_modules/wrangler/config-schema.json",
  // WP Instant Edge API — the only producer/consumer for the optimization
  // queue. Custom domain: api.wpinstant.dev
  "name": "wpinstant-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "api.wpinstant.dev", "custom_domain": true },
    { "pattern": "cdn.wpinstant.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wpinstant-db",
      "database_id": "a6ffe36b-3e1a-46a2-895b-91693b1538e1",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "5883ffa03f40476faf654faa8e531e48"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "wpinstant-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "wpinstant-optimization-queue",
        "binding": "OPTIMIZATION_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "wpinstant-optimization-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "wpinstant-dlq"
      },
      {
        "queue": "wpinstant-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 1
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SAAS_APP_URL": "https://app.wpinstant.dev",
    "NEXT_PUBLIC_API_BASE_URL": "https://api.wpinstant.dev"
  }
  // TODO(billing): add POLAR_PRODUCT_* plan IDs once Polar products exist.
  // Secrets (set via `wrangler secret put`, currently TODO placeholders):
  //   CLERK_SECRET_KEY, CLERK_WEBHOOK_SIGNING_SECRET,
  //   POLAR_ACCESS_TOKEN, POLAR_WEBHOOK_SECRET
}
