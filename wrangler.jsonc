{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turbopress",
  "main": "packages/edge-api/src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./packages/saas-app/.open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "turbopress"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "turbopress-db",
      "database_id": "b18efb43-46d8-4273-8fe8-4a82d64238ef",
      "migrations_dir": "packages/edge-api/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "e4d1d13005314aebbe15c5606b7ac23b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "turbopress-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "turbopress-optimization-queue",
        "binding": "OPTIMIZATION_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "turbopress-optimization-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "turbopress-dlq"
      }
    ]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SAAS_APP_URL": "https://turbopress.webaccessibility.workers.dev",
    "NEXT_PUBLIC_API_BASE_URL": "https://turbopress.webaccessibility.workers.dev",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_YnJpZWYtbWVlcmthdC0zMC5jbGVyay5hY2NvdW50cy5kZXYk"
  }
}
